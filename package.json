{
  "name": "origo-loop",
  "private": true,
  "version": "0.1.0",
  "description": "Origo Loop â€” an on-device UI agent that reads structure, not pixels.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test",
    "dev:tiffin": "vite apps/tiffin",
    "dev:debug": "vite tooling/debug",
    "measure": "pnpm --filter @tiffin/app build && node scripts/measure-screens.mjs",
    "shot": "node scripts/screenshot.mjs",
    "dev": "vite apps/demo",
    "e2e": "node scripts/e2e-demo.mjs",
    "record": "node scripts/record-demo.mjs",
    "assemble": "node scripts/make-shotcut-project.mjs",
    "video": "node scripts/render-video.mjs",
    "render": "node scripts/render-video.mjs && node scripts/verify-video.mjs",
    "verify:video": "node scripts/verify-video.mjs",
    "check:live": "node scripts/check-live.mjs",
    "measure:sites": "node scripts/measure-real-sites.mjs",
    "verify:flows": "node scripts/verify-flows.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "^20.14.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.12.0",
    "gpt-tokenizer": "^4.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
